<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:data="using:LOCKnet.Core.DataAbstractions"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.CredentialListView"
             x:DataType="vm:CredentialListViewModel"
             Background="{StaticResource BrushBg}">

    <Design.DataContext>
        <x:Static Member="vm:DesignData.CredentialList"/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top bar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

                <!-- Logo -->
                <Image Grid.Column="0"
                       Source="/Assets/favicon-32x32.png"
                       Width="30" Height="30"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1"
                           Text="LOCKnet"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBox Grid.Column="2"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Suchen…"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="Neu"
                        Classes="primary"
                        Command="{Binding AddCommand}"
                        Margin="12,0,0,0"
                        Padding="14,8"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="4"
                        Content="Bearbeiten"
                        Classes="ghost"
                        Command="{Binding EditCommand}"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="5"
                        Content="Hilfe"
                        Classes="ghost"
                        Command="{Binding ShowTutorialCommand}"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="6"
                        Content="Sperren"
                        Classes="ghost"
                        Command="{Binding LockCommand}"
                        Margin="8,0,0,0"
                        Padding="14,8"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── List ── -->
        <ListBox Grid.Row="1"
                 Padding="20,16"
                 ItemsSource="{Binding Credentials}"
                 SelectedItem="{Binding SelectedCredential, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.Styles>
                <!-- Base style: provides defaults so Style setters can override (Local Values would block this) -->
                <Style Selector="Border.credential-card">
                    <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Style>

                <!-- Suppress Fluent's built-in ListBoxItem highlight -->
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>

                <!-- Hover -->
                <Style Selector="ListBoxItem:pointerover Border.credential-card">
                    <Setter Property="Background" Value="#252B4A"/>
                </Style>

                <!-- Selected: accent left border + brighter background -->
                <Style Selector="ListBoxItem:selected Border.credential-card">
                    <Setter Property="Background" Value="#2D3575"/>
                    <Setter Property="BorderBrush" Value="#6C63FF"/>
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover Border.credential-card">
                    <Setter Property="Background" Value="#2D3575"/>
                    <Setter Property="BorderBrush" Value="#6C63FF"/>
                </Style>
                <Style Selector="ListBoxItem:selected:focus Border.credential-card">
                    <Setter Property="Background" Value="#2D3575"/>
                    <Setter Property="BorderBrush" Value="#6C63FF"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="data:CredentialRecord">
                    <Border Classes="credential-card"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="16,12"
                            Cursor="Hand">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            
                            <!-- Avatar -->
                            <Border Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    Background="{StaticResource BrushAccent}"
                                    Opacity="0.35"
                                    Margin="0,0,16,0"
                                    ClipToBounds="True">
                                <Grid>
                                    <mi:MaterialIcon Kind="{Binding IconKey, Converter={StaticResource StringToMaterialIconKindConverter}}"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IconKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IconKey, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding Username}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           IsVisible="{Binding Username, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <Border CornerRadius="4" Padding="5,2" Background="#1A2A5E"
                                        IsVisible="{Binding CredentialType, Converter={StaticResource CredentialTypeIsApiKeyConverter}}">
                                    <TextBlock Text="API-Schlüssel" FontSize="9" Foreground="#6C8FFF" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Url}"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushAccent}"
                                           IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="›"
                                       FontSize="18"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Bottom action bar ── -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurface}"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <Button Grid.Column="0"
                        Content="Löschen"
                        Classes="danger"
                        Command="{Binding DeleteCommand}"/>

                <Button Grid.Column="1"
                        Content="Kopieren"
                        Classes="ghost"
                        Command="{Binding CopyPasswordCommand}"
                        Margin="8,0,0,0"/>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <TextBlock Text="{Binding LockTimerText}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="{Binding LockTimerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushSuccess}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>

</UserControl>
