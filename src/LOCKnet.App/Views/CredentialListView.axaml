<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:data="using:LOCKnet.Core.DataAbstractions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.CredentialListView"
             x:DataType="vm:CredentialListViewModel"
             Background="#1a1d2e">

    <Design.DataContext>
        <vm:CredentialListViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top bar ── -->
        <Border Grid.Row="0"
                Background="#252840"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

                <!-- Logo -->
                <Image Grid.Column="0"
                       Source="/Assets/favicon-32x32.png"
                       Width="28" Height="28"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

                <TextBlock Grid.Column="1"
                           Text="LOCKnet"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#e8e8f0"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBox Grid.Column="2"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Suchen…"
                         Background="#2d3154"
                         Foreground="#e8e8f0"
                         BorderBrush="#3d4070"
                         CornerRadius="6"
                         Padding="10,8"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="+ Neu"
                        Command="{Binding AddCommand}"
                        Background="#6c63ff"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Padding="16,8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="4"
                        Content="✏️ Bearbeiten"
                        Command="{Binding EditCommand}"
                        Background="#2d3154"
                        Foreground="#e8e8f0"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="5"
                        Content="❓ Tutorial"
                        Command="{Binding ShowTutorialCommand}"
                        Background="#2d3154"
                        Foreground="#8888aa"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="6"
                        Content="🔒 Sperren"
                        Command="{Binding LockCommand}"
                        Background="#2d3154"
                        Foreground="#8888aa"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- ── List ── -->
        <ListBox Grid.Row="1"
                 Padding="20,16"
                 ItemsSource="{Binding Credentials}"
                 SelectedItem="{Binding SelectedCredential, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,4,0,4"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="data:CredentialRecord">
                    <Border CornerRadius="8"
                            Padding="16,12"
                            Cursor="Hand">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#252840"/>
                            </Style>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#2d3154"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#e8e8f0"/>
                                <TextBlock Text="{Binding Username}"
                                           FontSize="12"
                                           Foreground="#8888aa"
                                           IsVisible="{Binding Username, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding Url}"
                                           FontSize="11"
                                           Foreground="#6c63ff"
                                           IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="&#x203A;"
                                       FontSize="18"
                                       Foreground="#3d4070"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Bottom action bar ── -->
        <Border Grid.Row="2"
                Background="#252840"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <Button Grid.Column="0"
                        Content="🗑️ Löschen"
                        Command="{Binding DeleteCommand}"
                        Background="Transparent"
                        Foreground="#ff4757"
                        CornerRadius="6"
                        Padding="12,8"/>

                <Button Grid.Column="1"
                        Content="📋 Passwort kopieren"
                        Command="{Binding CopyPasswordCommand}"
                        Background="Transparent"
                        Foreground="#8888aa"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           Foreground="#2ed573"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            </Grid>
        </Border>

    </Grid>

</UserControl>
