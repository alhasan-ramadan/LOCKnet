<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.CredentialListView"
             x:DataType="vm:CredentialListViewModel"
             Background="#1a1d2e">

    <Design.DataContext>
        <vm:CredentialListViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top bar ── -->
        <Border Grid.Row="0"
                Background="#252840"
                Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                <TextBlock Grid.Column="0"
                           Text="🔒 LOCKnet"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#e8e8f0"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Suchen…"
                         Background="#2d3154"
                         Foreground="#e8e8f0"
                         BorderBrush="#3d4070"
                         CornerRadius="6"
                         Padding="10,8"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="+ Neu"
                        Command="{Binding AddCommand}"
                        Background="#6c63ff"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Padding="16,8"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="✏️ Bearbeiten"
                        Command="{Binding EditCommand}"
                        Background="#2d3154"
                        Foreground="#e8e8f0"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="4"
                        Content="🔒 Sperren"
                        Command="{Binding LockCommand}"
                        Background="#2d3154"
                        Foreground="#8888aa"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- ── List ── -->
        <ScrollViewer Grid.Row="1" Padding="20,16">
            <ItemsControl ItemsSource="{Binding Credentials}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CredentialListViewModel">
                        <!-- handled by outer binding -->
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252840"
                                CornerRadius="8"
                                Padding="16,12"
                                Cursor="Hand">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#e8e8f0"/>
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Foreground="#8888aa"
                                               IsVisible="{Binding Username, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding Url}"
                                               FontSize="11"
                                               Foreground="#6c63ff"
                                               IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Bottom action bar ── -->
        <Border Grid.Row="2"
                Background="#252840"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <Button Grid.Column="0"
                        Content="🗑️ Löschen"
                        Command="{Binding DeleteCommand}"
                        Background="Transparent"
                        Foreground="#ff4757"
                        CornerRadius="6"
                        Padding="12,8"/>

                <Button Grid.Column="1"
                        Content="📋 Passwort kopieren"
                        Command="{Binding CopyPasswordCommand}"
                        Background="Transparent"
                        Foreground="#8888aa"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           Foreground="#2ed573"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            </Grid>
        </Border>

    </Grid>

</UserControl>
