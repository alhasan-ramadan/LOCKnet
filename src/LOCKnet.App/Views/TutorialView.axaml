<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.TutorialView"
             x:DataType="vm:TutorialViewModel"
             Background="#1a1d2e">

    <Design.DataContext>
        <vm:TutorialViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,*">
        <Border Grid.Row="1"
                Width="560"
                HorizontalAlignment="Center"
                Background="#252840"
                CornerRadius="14"
                Padding="44,40"
                Margin="0,24">
            <StackPanel Spacing="28">

                <!-- Logo + App name -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10">
                    <Image Source="/Assets/favicon-32x32.png"
                           Width="32" Height="32"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="LOCKnet · Hilfe"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#e8e8f0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Step indicator -->
                <TextBlock Text="{Binding CurrentStepData.StepLabel}"
                           FontSize="12"
                           Foreground="#6c63ff"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <!-- Step card -->
                <Border Background="#1a1d2e"
                        CornerRadius="10"
                        Padding="28,24">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding CurrentStepData.Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#e8e8f0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentStepData.Content}"
                                   FontSize="14"
                                   Foreground="#b0b0c8"
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Content="← Zurück"
                            Command="{Binding BackCommand}"
                            Background="#2d3154"
                            Foreground="#e8e8f0"
                            CornerRadius="6"
                            Padding="18,10"
                            IsVisible="{Binding CanGoBack}"/>

                    <!-- Dots -->
                    <ItemsControl Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <ItemsControl.Items>
                            <Ellipse Width="8" Height="8" Fill="#6c63ff" Margin="3,0"/>
                            <Ellipse Width="8" Height="8" Fill="#3d4070" Margin="3,0"/>
                            <Ellipse Width="8" Height="8" Fill="#3d4070" Margin="3,0"/>
                            <Ellipse Width="8" Height="8" Fill="#3d4070" Margin="3,0"/>
                            <Ellipse Width="8" Height="8" Fill="#3d4070" Margin="3,0"/>
                        </ItemsControl.Items>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button Grid.Column="2"
                            Content="Weiter →"
                            Command="{Binding ForwardCommand}"
                            Background="#6c63ff"
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="6"
                            Padding="18,10"
                            IsVisible="{Binding CanGoForward}"/>

                    <Button Grid.Column="2"
                            Content="✓ Fertig"
                            Command="{Binding CloseCommand}"
                            Background="#2ed573"
                            Foreground="#1a1d2e"
                            FontWeight="Bold"
                            CornerRadius="6"
                            Padding="18,10"
                            IsVisible="{Binding IsLastStep}"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>
