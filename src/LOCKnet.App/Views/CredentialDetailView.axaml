<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.CredentialDetailView"
             x:DataType="vm:CredentialDetailViewModel"
             Background="#1a1d2e">

    <Design.DataContext>
        <vm:CredentialDetailViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,*">
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Width="520"
                    HorizontalAlignment="Center"
                    Background="#252840"
                    CornerRadius="12"
                    Padding="40,36"
                    Margin="0,24">
                <StackPanel Spacing="20">

                    <!-- Header -->
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#e8e8f0"/>

                    <!-- Title -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Titel *"
                                   FontSize="12"
                                   Foreground="#8888aa"/>
                        <TextBox Text="{Binding Title, Mode=TwoWay}"
                                 Watermark="z.B. GitHub, Google…"
                                 Background="#2d3154"
                                 Foreground="#e8e8f0"
                                 BorderBrush="#3d4070"
                                 CornerRadius="6"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Benutzername"
                                   FontSize="12"
                                   Foreground="#8888aa"/>
                        <TextBox Text="{Binding Username, Mode=TwoWay}"
                                 Watermark="optional"
                                 Background="#2d3154"
                                 Foreground="#e8e8f0"
                                 BorderBrush="#3d4070"
                                 CornerRadius="6"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Passwort *"
                                   FontSize="12"
                                   Foreground="#8888aa"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Masked (default) -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     PasswordChar="●"
                                     Watermark="Passwort"
                                     Background="#2d3154"
                                     Foreground="#e8e8f0"
                                     BorderBrush="#3d4070"
                                     CornerRadius="6,0,0,6"
                                     Padding="12,10"
                                     IsVisible="{Binding !IsPasswordVisible}"/>
                            <!-- Unmasked -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     Watermark="Passwort"
                                     Background="#2d3154"
                                     Foreground="#e8e8f0"
                                     BorderBrush="#3d4070"
                                     CornerRadius="6,0,0,6"
                                     Padding="12,10"
                                     IsVisible="{Binding IsPasswordVisible}"/>
                            <Button Grid.Column="1"
                                    Content="👁️"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="#3d4070"
                                    Foreground="#e8e8f0"
                                    CornerRadius="0,6,6,0"
                                    Padding="12,10"
                                    ToolTip.Tip="Passwort verstecken"
                                    IsVisible="{Binding IsPasswordVisible}"/>
                            <Button Grid.Column="1"
                                    Content="🙈"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="#3d4070"
                                    Foreground="#e8e8f0"
                                    CornerRadius="0,6,6,0"
                                    Padding="12,10"
                                    ToolTip.Tip="Passwort anzeigen"
                                    IsVisible="{Binding !IsPasswordVisible}"/>
                        </Grid>
                    </StackPanel>

                    <!-- URL -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="URL"
                                   FontSize="12"
                                   Foreground="#8888aa"/>
                        <TextBox Text="{Binding Url, Mode=TwoWay}"
                                 Watermark="https://…"
                                 Background="#2d3154"
                                 Foreground="#e8e8f0"
                                 BorderBrush="#3d4070"
                                 CornerRadius="6"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Notizen"
                                   FontSize="12"
                                   Foreground="#8888aa"/>
                        <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                 Watermark="optional"
                                 AcceptsReturn="True"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 Background="#2d3154"
                                 Foreground="#e8e8f0"
                                 BorderBrush="#3d4070"
                                 CornerRadius="6"
                                 Padding="12,10"/>
                    </StackPanel>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#ff4757"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="1"
                                Content="Abbrechen"
                                Command="{Binding CancelCommand}"
                                Background="#2d3154"
                                Foreground="#8888aa"
                                CornerRadius="6"
                                Padding="20,10"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Content="Speichern"
                                Command="{Binding SaveCommand}"
                                Background="#6c63ff"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Padding="20,10"/>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>
