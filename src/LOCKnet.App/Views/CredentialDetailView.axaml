<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.CredentialDetailView"
             x:DataType="vm:CredentialDetailViewModel"
             Background="{StaticResource BrushBg}">

    <Design.DataContext>
        <vm:CredentialDetailViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,*">
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Width="540"
                    HorizontalAlignment="Center"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="44,40"
                    Margin="0,24">
                <StackPanel Spacing="20">

                    <!-- Header -->
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"/>

                    <!-- Title -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Titel *"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Title, Mode=TwoWay}"
                                 Watermark="z.B. GitHub, Google…"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Benutzername"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Username, Mode=TwoWay}"
                                 Watermark="optional"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Passwort *"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Masked (default) -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     PasswordChar="●"
                                     Watermark="Passwort"
                                     CornerRadius="8,0,0,8"
                                     IsVisible="{Binding !IsPasswordVisible}"/>
                            <!-- Unmasked -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     Watermark="Passwort"
                                     CornerRadius="8,0,0,8"
                                     IsVisible="{Binding IsPasswordVisible}"/>
                            <Button Grid.Column="1"
                                    Content="👁️"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="{StaticResource BrushBorder}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    CornerRadius="0,8,8,0"
                                    Padding="12,10"
                                    ToolTip.Tip="Passwort verstecken"
                                    IsVisible="{Binding IsPasswordVisible}"/>
                            <Button Grid.Column="1"
                                    Content="🙈"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="{StaticResource BrushBorder}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    CornerRadius="0,8,8,0"
                                    Padding="12,10"
                                    ToolTip.Tip="Passwort anzeigen"
                                    IsVisible="{Binding !IsPasswordVisible}"/>
                        </Grid>
                    </StackPanel>

                    <!-- URL -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="URL"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Url, Mode=TwoWay}"
                                 Watermark="https://…"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Notizen"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                 Watermark="optional"
                                 AcceptsReturn="True"
                                 Height="80"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource BrushError}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="1"
                                Content="Abbrechen"
                                Classes="secondary"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Content="Speichern"
                                Classes="primary"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>