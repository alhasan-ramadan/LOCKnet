<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.CredentialDetailView"
             x:DataType="vm:CredentialDetailViewModel"
             x:Name="ROOT"
             Background="{StaticResource BrushBg}">

    <Design.DataContext>
        <vm:CredentialDetailViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*">
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Width="540"
                    HorizontalAlignment="Center"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="44,40"
                    Margin="0,24">
                <StackPanel Spacing="20">

                    <!-- Header -->
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"/>

                    <!-- Title -->
                    <!-- Credential Type Selector -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Typ"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton Content="Passwort"
                                         GroupName="CredType"
                                         IsChecked="{Binding IsPasswordCredential, Mode=TwoWay}"/>
                            <RadioButton Content="API-Schlüssel"
                                         GroupName="CredType"
                                         IsChecked="{Binding IsApiKeyCredential, Mode=TwoWay}"/>
                            <RadioButton Content="Backup Codes"
                                         GroupName="CredType"
                                         IsChecked="{Binding IsBackupCodesCredential, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Titel *"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Title, Mode=TwoWay}"
                                 Watermark="z.B. GitHub, Google…"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding UsernameLabel}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Username, Mode=TwoWay}"
                                 Watermark="optional"/>
                    </StackPanel>

                    <!-- Password / API Secret -->
                    <StackPanel Spacing="6" IsVisible="{Binding !IsBackupCodesCredential}">
                        <TextBlock Text="{Binding SecretFieldLabel}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Masked (default) -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     PasswordChar="●"
                                     Watermark="{Binding SecretFieldWatermark}"
                                     CornerRadius="8,0,0,8"
                                     IsVisible="{Binding !IsPasswordVisible}"/>
                            <!-- Unmasked -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     Watermark="{Binding SecretFieldWatermark}"
                                     CornerRadius="8,0,0,8"
                                     IsVisible="{Binding IsPasswordVisible}"/>
                            <Button Grid.Column="1"
                                    Content="👁️"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="{StaticResource BrushBorder}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    CornerRadius="0,8,8,0"
                                    Padding="12,10"
                                    ToolTip.Tip="Passwort verstecken"
                                    IsVisible="{Binding IsPasswordVisible}"/>
                            <Button Grid.Column="1"
                                    Content="🙈"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="{StaticResource BrushBorder}"
                                    Foreground="{StaticResource BrushTextPrimary}"
                                    CornerRadius="0,8,8,0"
                                    Padding="12,10"
                                    ToolTip.Tip="Passwort anzeigen"
                                    IsVisible="{Binding !IsPasswordVisible}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding Password, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Border Grid.Column="0"
                                    Margin="0,2,0,0">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,*,*,*,*"
                                          ColumnSpacing="4">
                                        <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{Binding StrengthSeg1}"/>
                                        <Border Grid.Column="1" Height="4" CornerRadius="2" Background="{Binding StrengthSeg2}"/>
                                        <Border Grid.Column="2" Height="4" CornerRadius="2" Background="{Binding StrengthSeg3}"/>
                                        <Border Grid.Column="3" Height="4" CornerRadius="2" Background="{Binding StrengthSeg4}"/>
                                        <Border Grid.Column="4" Height="4" CornerRadius="2" Background="{Binding StrengthSeg5}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding StrengthLabel}"
                                               FontSize="11"
                                               Foreground="{Binding StrengthColor}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel IsVisible="{Binding IsPasswordCredential}">
                        <Button Content="🎲 Generieren"
                                Classes="ghost"
                                Command="{Binding ToggleGeneratorCommand}"
                                HorizontalAlignment="Left"
                                Padding="10,6"/>

                        <Border Background="{StaticResource BrushInput}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Padding="16,12"
                                IsVisible="{Binding ShowGenerator}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Passwort generieren"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"/>

                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Laenge"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PasswordLength}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushTextPrimary}"/>
                                    </Grid>
                                    <Slider Minimum="8"
                                            Maximum="64"
                                            Value="{Binding PasswordLength, Mode=TwoWay}"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"/>
                                </StackPanel>

                                <WrapPanel>
                                    <CheckBox Content="Grossbuchstaben" IsChecked="{Binding UseUppercase, Mode=TwoWay}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Kleinbuchstaben" IsChecked="{Binding UseLowercase, Mode=TwoWay}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Zahlen" IsChecked="{Binding UseDigits, Mode=TwoWay}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Sonderzeichen" IsChecked="{Binding UseSpecial, Mode=TwoWay}"/>
                                </WrapPanel>

                                <Button Content="Passwort generieren"
                                        Classes="primary"
                                        Command="{Binding GeneratePasswordCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Backup Codes -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsBackupCodesCredential}">
                        <TextBlock Text="Backup-Codes *"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding BackupCodesInput, Mode=TwoWay}"
                                 Watermark="Ein Code pro Zeile oder mit ; / , getrennt"
                                 AcceptsReturn="True"
                                 Height="90"
                                 TextWrapping="Wrap"/>
                        <Button Content="Codes importieren"
                                Classes="ghost"
                                Command="{Binding ImportBackupCodesCommand}"
                                HorizontalAlignment="Left"
                                Padding="10,6"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Aktive kopieren"
                                    Classes="ghost"
                                    Command="{Binding CopyActiveBackupCodesCommand}"/>
                            <Button Content="Alle kopieren"
                                    Classes="ghost"
                                    Command="{Binding CopyAllBackupCodesCommand}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding BackupCodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                                        <Button Grid.Column="0"
                                                Content="✓"
                                                Classes="ghost"
                                                Command="{Binding #ROOT.DataContext.ToggleBackupCodeUsedCommand}"
                                                CommandParameter="{Binding}"
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="verwendet"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsUsed}"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                            <Button Content="Kopieren"
                                                    Classes="ghost"
                                                    Command="{Binding #ROOT.DataContext.CopyBackupCodeCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button
                                                Content="Entfernen"
                                                Classes="ghost"
                                                Command="{Binding #ROOT.DataContext.RemoveBackupCodeCommand}"
                                                CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- URL -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="URL"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Url, Mode=TwoWay}"
                                 Watermark="https://..."/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Icon"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <WrapPanel ItemHeight="36" ItemWidth="36" Orientation="Horizontal">
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Key}" Command="{Binding SetIconCommand}" CommandParameter="Key"><mi:MaterialIcon Kind="Key" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Lock}" Command="{Binding SetIconCommand}" CommandParameter="Lock"><mi:MaterialIcon Kind="Lock" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=LockOpen}" Command="{Binding SetIconCommand}" CommandParameter="LockOpen"><mi:MaterialIcon Kind="LockOpen" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Shield}" Command="{Binding SetIconCommand}" CommandParameter="Shield"><mi:MaterialIcon Kind="Shield" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Email}" Command="{Binding SetIconCommand}" CommandParameter="Email"><mi:MaterialIcon Kind="Email" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Web}" Command="{Binding SetIconCommand}" CommandParameter="Web"><mi:MaterialIcon Kind="Web" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Database}" Command="{Binding SetIconCommand}" CommandParameter="Database"><mi:MaterialIcon Kind="Database" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Github}" Command="{Binding SetIconCommand}" CommandParameter="Github"><mi:MaterialIcon Kind="Github" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Google}" Command="{Binding SetIconCommand}" CommandParameter="Google"><mi:MaterialIcon Kind="Google" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Apple}" Command="{Binding SetIconCommand}" CommandParameter="Apple"><mi:MaterialIcon Kind="Apple" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Microsoft}" Command="{Binding SetIconCommand}" CommandParameter="Microsoft"><mi:MaterialIcon Kind="Microsoft" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Bank}" Command="{Binding SetIconCommand}" CommandParameter="Bank"><mi:MaterialIcon Kind="Bank" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=CreditCard}" Command="{Binding SetIconCommand}" CommandParameter="CreditCard"><mi:MaterialIcon Kind="CreditCard" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Laptop}" Command="{Binding SetIconCommand}" CommandParameter="Laptop"><mi:MaterialIcon Kind="Laptop" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Phone}" Command="{Binding SetIconCommand}" CommandParameter="Phone"><mi:MaterialIcon Kind="Phone" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Server}" Command="{Binding SetIconCommand}" CommandParameter="Server"><mi:MaterialIcon Kind="Server" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Wifi}" Command="{Binding SetIconCommand}" CommandParameter="Wifi"><mi:MaterialIcon Kind="Wifi" Width="20" Height="20"/></Button>
                            <Button Classes="ghost" Width="36" Height="36" Margin="0,0,8,8" Background="{Binding IconKey, Converter={StaticResource IconSelectedBrushConverter}, ConverterParameter=Star}" Command="{Binding SetIconCommand}" CommandParameter="Star"><mi:MaterialIcon Kind="Star" Width="20" Height="20"/></Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Notizen"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Notes, Mode=TwoWay}"
                                 Watermark="optional"
                                 AcceptsReturn="True"
                                 Height="80"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource BrushError}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="1"
                                Content="Abbrechen"
                                Classes="secondary"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Content="Speichern"
                                Classes="primary"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>
