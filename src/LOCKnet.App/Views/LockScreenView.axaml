<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.LockScreenView"
             x:DataType="vm:LockScreenViewModel"
             Background="{StaticResource BrushBg}">

    <Design.DataContext>
        <vm:LockScreenViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,*">
        <StackPanel Grid.Row="1"
                    Width="380"
                    HorizontalAlignment="Center"
                    Spacing="0">

            <!-- Lock Icon -->
            <Border Width="80" Height="80"
                    CornerRadius="40"
                    Background="{StaticResource BrushSurface}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <TextBlock Text="■"
                           FontSize="28"
                           Foreground="{StaticResource BrushAccent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock Text="Sitzung gesperrt"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <!-- Subtitle -->
            <TextBlock Text="Gib dein Master-Passwort ein, um fortzufahren."
                       FontSize="14"
                       Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Card -->
            <Border Background="{StaticResource BrushSurface}"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="40,36">
                <StackPanel Spacing="20">

                    <!-- Password -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Master-Passwort"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Password, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Watermark="Passwort eingeben…"/>
                    </StackPanel>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource BrushError}"
                               FontSize="12"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Unlock Button -->
                    <Button Content="Entsperren"
                            Classes="primary"
                            Command="{Binding UnlockCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>

</UserControl>