<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LOCKnet.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LOCKnet.App.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource BrushBg}">

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,*">
        <!-- Footer credit -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Spacing="2">
            <TextBlock Text="Alhasan Ramadan"
                       FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="https://github.com/alhasan-ramadan/LOCKnet"
                       FontSize="11"
                       Foreground="{StaticResource BrushAccent}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Width="400"
                    HorizontalAlignment="Center"
                    Spacing="0">

            <!-- Logo / Title -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0,0,0,8">
                <Image Source="/Assets/favicon-32x32.png"
                       Width="40" Height="40"
                       VerticalAlignment="Center"/>
                <TextBlock Text="LOCKnet"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Local Offline Credential Keeper"
                       FontSize="13"
                       Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,44"/>

            <Separator Background="{StaticResource BrushBorder}" Height="1" Margin="0,0,0,32"/>

            <!-- Card -->
            <Border Background="{StaticResource BrushSurface}"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="40,36">
                <StackPanel Spacing="20">

                    <!-- Mode heading -->
                    <TextBlock Text="Ersteinrichtung"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               IsVisible="{Binding IsSetupMode}"/>
                    <TextBlock Text="Willkommen zurück"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               IsVisible="{Binding !IsSetupMode}"/>

                    <!-- Password -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Master-Passwort"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding Password, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Watermark="Passwort eingeben…"/>
                    </StackPanel>

                    <!-- Confirm Password (only setup mode) -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsSetupMode}">
                        <TextBlock Text="Passwort bestätigen"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Watermark="Passwort wiederholen…"/>
                    </StackPanel>

                    <!-- Error -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource BrushError}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Buttons -->
                    <Button Content="Entsperren"
                            Classes="primary"
                            Command="{Binding UnlockCommand}"
                            IsVisible="{Binding !IsSetupMode}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                    <Button Content="Einrichten &amp; Entsperren"
                            Classes="primary"
                            Command="{Binding SetupCommand}"
                            IsVisible="{Binding IsSetupMode}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>

</UserControl>